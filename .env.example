# .env.example — copy from this file to .env, never commit the actual .env file
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Local Development AWS Credentials (for local script testing)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-south-1
S3_BUCKET_NAME=github-repository-data-analysis

# Local Development Databricks Credentials
DATABRICKS_HOST=https://your-workspace-instance.cloud.databricks.com
DATABRICKS_TOKEN=dapixxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATABRICKS_CATALOG=github_analytics
DATABRICKS_SCHEMA=bronze
DATABRICKS_SQL_WAREHOUSE_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# --- Airflow Bootstrapping (Optional but recommended for Docker) ---
# Airflow reads these to automatically create Connections and Variables on startup
AIRFLOW_CONN_AWS_DEFAULT=aws://AKIAXXXXXXXXXXXXXXXX:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@
AIRFLOW_CONN_DATABRICKS_DEFAULT=databricks://:dapixxxxxxxxxxxxxxxxxxxxxxxxxxxx@your-workspace-instance.cloud.databricks.com
AIRFLOW_VAR_S3_BUCKET_NAME=github-repository-data-analysis
AIRFLOW_VAR_REPO_LIST=["apache/spark"]
AIRFLOW_VAR_DATABRICKS_CATALOG=github_analytics
AIRFLOW_VAR_DATABRICKS_SCHEMA=bronze
AIRFLOW_VAR_DATABRICKS_NOTEBOOK_PATH=/Repos/<your-email>/<repo-name>/databricks/bronze/bronze_notebook
# S3_BUCKET_NAME is also required as a container env var (used by dbt's
# create_silver_external_table macro via env_var('S3_BUCKET_NAME'))
