# Copy this file to secrets.toml and fill in your AWS credentials.
# These are used by DuckDB's httpfs extension to read Parquet from S3.

[aws]
access_key_id = "YOUR_AWS_ACCESS_KEY_ID"
secret_access_key = "YOUR_AWS_SECRET_ACCESS_KEY"
region = "us-east-1"
s3_bucket = "github-repository-data-analysis"
